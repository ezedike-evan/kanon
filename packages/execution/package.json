{
  "name": "@kanon/execution",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./perpl-trade": "./src/perpl-trade.ts",
