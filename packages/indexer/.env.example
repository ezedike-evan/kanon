# Copy to .env for local runs. On Envio Cloud set the same names (ENVIO_ prefix
# is required there) with `envio-cloud indexer env set` or the dashboard.

# HyperSync access. Create a token at https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=

# The chain: 143 is Monad mainnet (the default), 10143 is Monad testnet.
# `testnet.env` holds every value below for the testnet deployment.
ENVIO_CHAIN_ID=

# First block to index from: the earliest deployment block of any Kanon contract.
ENVIO_START_BLOCK=0

# Contract addresses on Monad mainnet (chain 143).
ENVIO_STRATEGY_REGISTRY=
ENVIO_REFUSAL_GATE=
ENVIO_THRESHOLD_MARKET=
ENVIO_MARGIN_ACCOUNT=
ENVIO_INSURANCE_FUND=
ENVIO_VAULT_FACTORY=
ENVIO_CANONICAL_SERIES_BTC=
ENVIO_CANONICAL_SERIES_ETH=
