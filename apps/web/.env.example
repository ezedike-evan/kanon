# Public client config. Nothing here may be a secret: it ships in the browser bundle.
# Leave NEXT_PUBLIC_CHAIN_ID unset for Monad mainnet (143); 10143 selects testnet.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_SERIES_BTC_USD=
NEXT_PUBLIC_SERIES_ETH_USD=
NEXT_PUBLIC_THRESHOLD_MARKET_ADDRESS=
# Testnet-only surfaces (margin, vaults). Do not set on mainnet.
NEXT_PUBLIC_VAULT_CHAIN_ID=
NEXT_PUBLIC_VAULT_COLLATERAL_ADDRESS=
NEXT_PUBLIC_VAULT_COLLATERAL_DECIMALS=
NEXT_PUBLIC_VAULT_COLLATERAL_SYMBOL=
NEXT_PUBLIC_VAULT_FACTORY_ADDRESS=
# Must not embed a provider API key.
NEXT_PUBLIC_VAULT_RPC_URL=
NEXT_PUBLIC_VAULT_START_BLOCK=
