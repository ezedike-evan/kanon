{
  "expo": {
    "name": "Kanon",
    "slug": "kanon",
    "scheme": "kanon",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D10",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.kanon.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Kanon signs the rules you pin with your device passkey."
      }
    },
    "android": {
      "package": "app.kanon.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-local-authentication",
      "expo-secure-store",
      "expo-web-browser",
      "react-native-quick-crypto",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1062104f-a7eb-49ac-84f2-1b1995c232b0"
      }
    },
    "owner": "phoenixwolf"
  }
}
