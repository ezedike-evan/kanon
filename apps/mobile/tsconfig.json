{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "nativewind",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "lib": ["ES2022", "DOM"],
    "types": ["nativewind/types", "expo-router/types"],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
