# Public client config. Nothing here may be a secret: it ships in the app bundle.
# Leave EXPO_PUBLIC_CHAIN_ID unset for Monad mainnet (143); 10143 selects testnet.
EXPO_PUBLIC_CHAIN_ID=
EXPO_PUBLIC_CONVEX_URL=
# The market data gateway (packages/gateway), e.g. http://localhost:8787. Optional: when set,
# charts and pair prices are read from the venue through it; unset, they stay on Convex.
# On a phone or an emulator `localhost` is the device itself: use the address of the machine
# the gateway runs on.
EXPO_PUBLIC_GATEWAY_URL=
# The Kanon indexer's GraphQL endpoint on Envio HyperIndex (packages/indexer), e.g. the hosted
# address from the Envio dashboard. Optional: when set, Profile > Previous rules lists what the
# chain holds for the signed-in wallet's rules; unset, that section says it is not connected.
# Public data: must not carry an admin secret. It must index the same chain as EXPO_PUBLIC_CHAIN_ID.
EXPO_PUBLIC_INDEXER_URL=
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
EXPO_PUBLIC_REGISTRY_ADDRESS=
EXPO_PUBLIC_SERIES_BTC_USD=
EXPO_PUBLIC_SERIES_ETH_USD=
EXPO_PUBLIC_THRESHOLD_MARKET_ADDRESS=
# Testnet-only surfaces (margin, vaults). Do not set on mainnet.
EXPO_PUBLIC_VAULT_CHAIN_ID=
EXPO_PUBLIC_VAULT_COLLATERAL_ADDRESS=
EXPO_PUBLIC_VAULT_COLLATERAL_DECIMALS=
EXPO_PUBLIC_VAULT_COLLATERAL_SYMBOL=
EXPO_PUBLIC_VAULT_FACTORY_ADDRESS=
# Must not embed a provider API key.
EXPO_PUBLIC_VAULT_RPC_URL=
EXPO_PUBLIC_VAULT_START_BLOCK=
